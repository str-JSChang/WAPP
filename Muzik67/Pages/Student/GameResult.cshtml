@page
@model Muzik67.Pages.Student.GameResultModel
@{
    ViewData["Title"] = "Game Result";
    var saved = bool.TryParse(Request.Query["saved"], out var savedValue) && savedValue;
}

<!-- Styles for the game result and student progress pages -->
<link rel="stylesheet" href="~/css/student-progress.css" asp-append-version="true" />

<div class="student-feature-page container py-4 py-lg-5 @(saved ? "result-saved" : "")"
     data-confetti="@saved.ToString().ToLowerInvariant()">
    <!-- Page navigation -->
    <div class="student-page-toolbar">
        <a asp-page="/Student/GameSelection" class="btn btn-outline-dark rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Games
        </a>
        <a asp-page="/Student/Progress" class="btn btn-outline-dark rounded-pill px-4">
            View My Progress <i class="bi bi-bar-chart-line ms-1"></i>
        </a>
    </div>

    <!-- Game result summary -->
    <section class="result-card mx-auto mt-4" aria-labelledby="result-title">
        <div class="result-icon @(saved ? "celebrate-icon" : "")" aria-hidden="true">
            <i class="bi bi-trophy"></i>
        </div>
        <p class="text-uppercase text-muted fw-semibold small mb-2">Game completed</p>
        <h1 id="result-title" class="feature-title mb-2">Result</h1>
        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-warning result-error" role="alert">
                <i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>
                @Model.ErrorMessage
            </div>
            <a asp-page="/Student/GameSelection" class="btn btn-primary rounded-pill px-4">
                Choose a Game
            </a>
        }
        else
        {
            <p class="text-muted mb-4">@Model.Game?.GameName</p>

            <!-- Confirmation shown after the score is saved -->
            @if (saved)
            {
                <div class="alert alert-success" role="status">
                    Your score has been saved.
                </div>
            }

            <!-- Score and performance message -->
            <div class="score-panel">
                <span class="score-label">Score</span>
                <strong class="score-value">@Model.Score / @Model.TotalQuestions</strong>
                <span class="score-percentage">@Model.ScorePercentage%</span>
            </div>

            <p class="result-message">
                @if (Model.ScorePercentage >= 80)
                {
                    <text>Excellent work! Keep up the great music practice.</text>
                }
                else if (Model.ScorePercentage >= 50)
                {
                    <text>Good effort! You are making progress. Keep practising to improve your score.</text>
                }
                else
                {
                    <text>Do not give up! Try again and practise one question at a time.</text>
                }
            </p>

            @if (saved)
            {
                <p class="celebration-message" role="status">
                    <i class="bi bi-stars me-1" aria-hidden="true"></i>
                    You did it! Your progress has been updated.
                </p>
            }

            <!-- Save only once; playing again starts a new result flow -->
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                @if (!saved)
                {
                    <form method="post">
                        <input type="hidden" asp-for="GameId" />
                        <input type="hidden" asp-for="Score" />
                        <input type="hidden" asp-for="Attempts" />
                        <input type="hidden" asp-for="SaveResult" value="true" />
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Save Score</button>
                    </form>
                }
                <a asp-page="/Student/GameSelection" class="btn btn-outline-dark rounded-pill px-4">Play Again</a>
            </div>
        }
    </section>
</div>

@if (saved)
{
    <div id="confettiContainer" class="confetti-container" aria-hidden="true"></div>
}

@section Scripts {
    @if (saved)
    {
        <script>
            // Starts the celebration after a result is successfully saved
            document.addEventListener("DOMContentLoaded", function () {
                startResultCelebration();
            });

            function startResultCelebration() {
                const container = document.getElementById("confettiContainer");
                if (!container) return;

                const colors = ["#f97316", "#facc15", "#22c55e", "#38bdf8", "#a855f7", "#fb7185"];
                const confettiCount = 70;

                for (let index = 0; index < confettiCount; index++) {
                    const piece = document.createElement("span");
                    piece.className = "confetti-piece";
                    piece.style.backgroundColor = colors[index % colors.length];
                    piece.style.left = `${Math.random() * 100}%`;
                    piece.style.animationDelay = `${Math.random() * 0.7}s`;
                    piece.style.animationDuration = `${2.5 + Math.random() * 1.8}s`;
                    piece.style.transform = `rotate(${Math.random() * 360}deg)`;
                    container.appendChild(piece);
                }

                window.setTimeout(function () {
                    container.replaceChildren();
                }, 4800);

            }
        </script>
    }
}
