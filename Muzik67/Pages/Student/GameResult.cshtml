@page
@model Muzik67.Pages.Student.GameResultModel
@{
    ViewData["Title"] = "Game Result";
    var stars = Math.Clamp((int)Math.Ceiling(Model.ScorePercentage / 20.0), 0, 5);
}

<link rel="stylesheet" href="~/css/student-progress.css" asp-append-version="true" />

<div class="student-feature-page container py-4 py-lg-5 result-saved" data-confetti="true">
    <header class="mc-status-bar d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
        <div>
            <p class="mb-1 text-white">RESULTS</p>
            <h1 class="h5 mb-0 text-white">@(Model.Game?.GameName ?? "Music challenge")</h1>
        </div>
        <div class="flex-grow-1 mc-result-xp">
            <p class="mc-lime-text mb-1 text-md-end">XP @Model.ScorePercentage / 100</p>
            <div class="mc-xp-track" role="progressbar" aria-valuenow="@Model.ScorePercentage" aria-valuemin="0" aria-valuemax="100">
                <span class="mc-xp-fill" style="width: @Model.ScorePercentage%"></span>
            </div>
        </div>
    </header>

    <nav class="mc-stage-tabs" aria-label="Lesson stages">
        <a asp-page="/Student/MusicLessonSelection">1 Learn</a>
        <a asp-page="/Student/GameSelection">2 Practice</a>
        <span>3 Challenge</span>
        <span class="active">4 Reward</span>
    </nav>

        <p class="mc-result-lead">
            @(Model.ScorePercentage >= 80
                ? "GREAT JOB! You completed the challenge and earned a strong score."
                : "NICE TRY! Review the lesson, then replay the challenge to raise your score.")
        </p>

        <div class="alert alert-success" role="status">Your verified game result was saved automatically.</div>

        <section class="mc-result-grid" aria-labelledby="result-title">
            <article class="mc-result-panel score-panel">
                <h2 id="result-title" class="h6">YOUR SCORE</h2>
                <div class="mc-stars" aria-label="@stars out of 5 stars">
                    @for (var index = 1; index <= 5; index++)
                    {
                        <span class="@(index <= stars ? "mc-star-earned" : "mc-star-empty")" aria-hidden="true">★</span>
                    }
                </div>
                <strong class="score-value">@Model.Score / @Model.TotalQuestions</strong>
                <span class="score-percentage">@Model.ScorePercentage% mastery</span>
                <div class="mc-xp-award">+@Model.ScorePercentage XP</div>
            </article>

            <article class="mc-result-panel">
                <h2 class="h6">ANSWER REVIEW</h2>
                <dl class="mc-review-list">
                    <div><dt>Challenge</dt><dd>@Model.Game?.GameName</dd></div>
                    <div><dt>Questions</dt><dd>@Model.TotalQuestions</dd></div>
                    <div><dt>Correct</dt><dd>@Model.Score</dd></div>
                    <div><dt>Attempts</dt><dd>@Model.Attempts</dd></div>
                    <div><dt>Status</dt><dd class="@(Model.ScorePercentage >= 80 ? "review-ok" : "review-retry")">@(Model.ScorePercentage >= 80 ? "OK" : "RETRY")</dd></div>
                </dl>
            </article>

            <article class="mc-result-panel mc-badge-panel">
                <h2 class="h6">BADGE @(Model.ScorePercentage >= 80 ? "UNLOCKED" : "PROGRESS")</h2>
                <div class="d-flex align-items-center gap-3">
                    <span class="mc-badge-block" aria-hidden="true">@(Model.ScorePercentage >= 80 ? "★" : "?")</span>
                    <p class="mb-0">@(Model.ScorePercentage >= 80 ? "Sound Explorer — challenge cleared." : "Reach 80% to unlock Sound Explorer.")</p>
                </div>
            </article>

            <article class="mc-result-panel">
                <h2 class="h6">NEXT STEP</h2>
                <p>@(Model.ScorePercentage >= 80 ? "Continue to another musical challenge." : "Replay this game and listen carefully to each sound.")</p>
                <a asp-page="/Student/GameSelection" class="btn btn-outline-dark w-100">Retry / choose game</a>
            </article>
        </section>

        <div class="mc-result-actions">
            <a asp-page="/Student/GameSelection" class="btn btn-outline-dark">&lt; Retry quiz</a>
            <a asp-page="/Student/StudentDashboard" class="btn btn-outline-dark">Home map</a>
            <a asp-page="/Student/Progress" class="btn btn-primary">View progress &gt;</a>
        </div>
</div>

<div id="confettiContainer" class="confetti-container" aria-hidden="true"></div>

@section Scripts {
    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const container = document.getElementById("confettiContainer");
                if (!container) return;

                const colors = ["#72ff1d", "#f2aa2c", "#e94b4b", "#368bd5", "#45d9d0"];
                for (let index = 0; index < 55; index++) {
                    const piece = document.createElement("span");
                    piece.className = "confetti-piece";
                    piece.style.backgroundColor = colors[index % colors.length];
                    piece.style.left = `${Math.random() * 100}%`;
                    piece.style.animationDelay = `${Math.random() * 0.6}s`;
                    container.appendChild(piece);
                }

                window.setTimeout(function () { container.replaceChildren(); }, 4200);
            });
    </script>
}
