@page
@model Muzik67.Pages.Student.ProgressModel
@{
    ViewData["Title"] = "My Learning Progress";
}

<!-- Styles for progress dashboard -->
<link rel="stylesheet" href="~/css/student-progress.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/progress.css" asp-append-version="true" />

<div class="student-feature-page container py-4 py-lg-5">
    <!-- Page navigation toolbar -->
    <div class="student-page-toolbar mb-3">
        <a asp-page="/Student/StudentDashboard" class="btn btn-outline-dark rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
        </a>
        <a asp-page="/Student/GameSelection" class="btn btn-primary rounded-pill px-4">
            Play a Game <i class="bi bi-controller ms-1"></i>
        </a>
    </div>

    <!-- Progress page heading -->
    <div class="progress-heading text-center mb-4">
        <p class="text-uppercase text-muted fw-semibold small mb-1">Student Profile</p>
        <h1 class="feature-title">Learning Progress</h1>
        <p class="text-muted mb-0">Saved activity and highest scores for <strong>@Model.Username</strong></p>
    </div>

    <!-- Student progress summary statistics -->
    <div class="progress-summary-row row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="summary-card">
                <i class="bi bi-controller summary-icon text-primary" aria-hidden="true"></i>
                <span>Games Completed</span>
                <strong>@Model.CompletedGames</strong>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="summary-card">
                <i class="bi bi-arrow-repeat summary-icon text-info" aria-hidden="true"></i>
                <span>Total Attempts</span>
                <strong>@Model.TotalAttempts</strong>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="summary-card">
                <i class="bi bi-star-fill summary-icon text-warning" aria-hidden="true"></i>
                <span>Average Mastery</span>
                <strong>@Model.AverageScore%</strong>
            </div>
        </div>
    </div>

    <!-- Game Mastery (Visual Progress Bars) -->
    <section class="progress-list-card mb-4" aria-labelledby="games-mastery-title">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
            <div class="d-flex align-items-center gap-2">
                <span class="section-icon"><i class="bi bi-trophy"></i></span>
                <h2 id="games-mastery-title" class="section-title mb-0 fs-4">Game Mastery</h2>
            </div>
            <span class="text-muted small">Highest score achieved</span>
        </div>

        @if (Model.GameProgress.Count == 0)
        {
            <div class="empty-progress-state">
                <i class="bi bi-controller fs-1 mb-2" aria-hidden="true"></i>
                <p class="mb-3">You have not completed any games yet.</p>
                <a asp-page="/Student/GameSelection" class="btn btn-primary rounded-pill px-4">Start Playing</a>
            </div>
        }
        else
        {
            @foreach (var game in Model.GameProgress)
            {
                <div class="game-progress-row">
                    <div class="game-progress-name">
                        <strong>@game.GameName</strong>
                        <span>@game.Difficulty · @game.Attempts total attempt(s) · Last played @game.LastCompleted.ToLocalTime().ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="game-progress-meter" role="progressbar"
                         aria-label="@game.GameName score"
                         aria-valuenow="@game.ScorePercentage" aria-valuemin="0" aria-valuemax="100">
                        <span style="width: @game.ScorePercentage%"></span>
                    </div>
                    <strong class="game-score">@game.HighestScore / @game.TotalQuestions</strong>
                </div>
            }
        }
    </section>

    <!-- Recent Game & Quiz Activity Log (Detailed History Table) -->
    <section class="progress-panel mb-4" aria-labelledby="activity-heading">
        <div class="panel-heading">
            <span class="section-icon"><i class="bi bi-clock-history"></i></span>
            <div>
                <h2 id="activity-heading" class="mb-0">Recent Activity Log</h2>
                <p class="text-muted small mb-0">Review results separately by game.</p>
            </div>
        </div>

        <form method="get" class="row g-2 align-items-end p-3 border-bottom">
            <div class="col-12 col-md-8">
                <label asp-for="SelectedGameId" class="form-label fw-semibold">Filter by game</label>
                <select asp-for="SelectedGameId" class="form-select">
                    <option value="">All games</option>
                    @foreach (var game in Model.AvailableGames)
                    {
                        <option value="@game.GameId">@game.GameName</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-auto">
                <button type="submit" class="btn btn-primary">Apply filter</button>
                @if (Model.SelectedGameId.HasValue)
                {
                    <a asp-page="/Student/Progress" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>

        @if (Model.RecentResults.Count > 0)
        {
            <div class="table-responsive">
                <table class="table align-middle progress-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Game / Quiz</th>
                            <th scope="col">Score</th>
                            <th scope="col">Questions</th>
                            <th scope="col">Completed Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model.RecentResults)
                        {
                            <tr>
                                <td class="fw-semibold">@result.GameName</td>
                                <td><span class="badge bg-primary rounded-pill px-3">@result.Score correct</span></td>
                                <td>@result.Score / @result.TotalQuestions</td>
                                <td>@result.CompletedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="progress-empty">
                <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
                <p class="mb-1 fw-semibold">No recent activity recorded yet</p>
                <p class="text-muted small mb-0">Complete music quizzes to see your attempt log here.</p>
            </div>
        }
    </section>

    <section class="progress-panel" aria-labelledby="lessons-heading">
        <div class="panel-heading">
            <span class="section-icon"><i class="bi bi-music-note-list"></i></span>
            <div>
                <h2 id="lessons-heading" class="mb-0">Lesson Progress</h2>
                <p class="text-muted small mb-0">Theory reading and completed learning materials.</p>
            </div>
        </div>
        @if (Model.LessonProgress.Count == 0)
        {
            <div class="progress-empty">
                <i class="bi bi-book" aria-hidden="true"></i>
                <p class="mb-1 fw-semibold">No lessons completed yet</p>
                <a asp-page="/Student/MusicLessonSelection" class="btn btn-sm btn-outline-dark rounded-pill px-3 mt-3">Explore Lessons</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle progress-table mb-0">
                    <thead><tr><th>Lesson</th><th>Completed</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var lesson in Model.LessonProgress)
                    {
                        <tr>
                            <td class="fw-semibold">@lesson.LessonTitle</td>
                            <td>@lesson.CompletedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</td>
                            <td><a asp-page="/Student/LessonContent" asp-route-id="@lesson.ContentId">Review</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="progress-panel mt-4" aria-labelledby="badges-heading">
        <div class="panel-heading">
            <span class="section-icon"><i class="bi bi-award"></i></span>
            <div><h2 id="badges-heading" class="mb-0">Earned Badges</h2><p class="text-muted small mb-0">Milestones saved to your account.</p></div>
        </div>
        @if (Model.Badges.Count == 0)
        {
            <div class="progress-empty"><p class="mb-0">Score 80% or higher in a game to earn your first badge.</p></div>
        }
        else
        {
            <div class="row g-3 p-3">
            @foreach (var badge in Model.Badges)
            {
                <div class="col-12 col-md-6"><div class="summary-card"><i class="bi bi-star-fill summary-icon text-warning"></i><span>@badge.Name</span><small>@badge.EarnedAt.ToLocalTime().ToString("dd MMM yyyy")</small></div></div>
            }
            </div>
        }
    </section>
</div>
