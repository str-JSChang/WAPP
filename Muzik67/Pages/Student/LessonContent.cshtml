@page "{id:int}"
@model wapp.Muzik67.Pages.Student.LessonContentModel
@{
    var lesson = Model.Lesson;
    ViewData["Title"] = lesson.Title;
    var notes = new[]
    {
        (Name: "C", Frequency: 261.63, Color: "red"),
        (Name: "D", Frequency: 293.66, Color: "pink"),
        (Name: "E", Frequency: 329.63, Color: "purple"),
        (Name: "F", Frequency: 349.23, Color: "blue"),
        (Name: "G", Frequency: 392.00, Color: "green"),
        (Name: "A", Frequency: 440.00, Color: "lime"),
        (Name: "B", Frequency: 493.88, Color: "gold"),
        (Name: "C", Frequency: 523.25, Color: "orange")
    };
}

<link rel="stylesheet" href="~/css/lesson-content.css" asp-append-version="true" />

<div class="container py-4 py-lg-5 mc-lesson-page">
    <header class="mc-status-bar d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
        <div>
            <p class="mb-1 text-white">@lesson.DifficultyLevel.ToUpperInvariant() · @lesson.ContentType.ToUpperInvariant()</p>
            <h1 class="h5 mb-0 text-white">@lesson.Title</h1>
        </div>
        <div class="mc-result-xp">
            <p class="mc-lime-text mb-1 text-lg-end">XP 40 / 100</p>
            <div class="mc-xp-track" aria-label="40 out of 100 lesson XP">
                <span class="mc-xp-fill xp-40"></span>
            </div>
        </div>
    </header>

    <nav class="mc-stage-tabs" aria-label="Lesson stages">
        <span class="active">1 Learn</span>
        <span>2 Practice</span>
        <a asp-page="/Student/GameSelection">3 Challenge</a>
        <span aria-disabled="true">4 Reward</span>
    </nav>

    <p class="mc-lesson-goal"><strong>GOAL:</strong> @lesson.Description</p>

    <section class="mc-note-board" aria-labelledby="practice-title">
        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mb-3">
            <h2 id="practice-title" class="h6 mb-0">Practice: note-block hotbar</h2>
            <span class="small">Color = pitch height</span>
        </div>

        <div class="mc-note-grid">
            @for (var index = 0; index < notes.Length; index++)
            {
                var note = notes[index];
                <button type="button" class="mc-note-key @note.Color" data-frequency="@note.Frequency" onclick="playTone(@note.Frequency, this)">
                    <span class="mc-note-cube" aria-hidden="true"></span>
                    <strong>@note.Name</strong>
                </button>
            }
        </div>

        <div class="d-flex justify-content-between small mt-2"><span>Low</span><span>High</span></div>
        <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3 mt-3">
            <button type="button" class="btn btn-outline-dark" id="playScaleBtn">Play the scale</button>
            <span class="small">Click a block to hear it.</span>
        </div>
    </section>

    <div class="mc-lesson-lower-grid">
        <section class="mc-result-panel">
            <h2 class="h6">CHALLENGE: Which is higher?</h2>
            <div class="d-flex gap-3">
                <button type="button" class="mc-mini-note red" onclick="playTone(261.63, this)" aria-label="Play low C"><span></span></button>
                <button type="button" class="mc-mini-note blue" onclick="playTone(523.25, this)" aria-label="Play high C"><span></span></button>
            </div>
            <a asp-page="/Student/GameSelection" class="btn btn-primary mt-3">Try a challenge &gt;</a>
        </section>

        <section class="mc-result-panel">
            <h2 class="h6">REWARD</h2>
            <div class="d-flex align-items-center gap-3">
                <span class="mc-badge-block" aria-hidden="true">?</span>
                <p class="mb-0">Finish a challenge to unlock a music explorer badge.</p>
            </div>
        </section>
    </div>

    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mt-3">
        <a asp-page="/Student/MusicLessonSelection" class="btn btn-outline-dark">&lt; Back</a>
        <a asp-page="/Student/MusicLessonSelection" class="btn btn-primary">Next lesson &gt;</a>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("playScaleBtn")?.addEventListener("click", function () {
            const keys = Array.from(document.querySelectorAll(".mc-note-key"));
            keys.forEach(function (key, index) {
                window.setTimeout(function () {
                    playTone(Number(key.dataset.frequency), key);
                }, index * 280);
            });
        });
    </script>
}
