@page
@model Muzik67.Pages.Student.GameSelectionModel
@{
    ViewData["Title"] = "Game Selection";
}

<link rel="stylesheet" href="~/css/game-selection.css" asp-append-version="true" />


<div class="container py-5">

    <!-- Back Button-->
    <div class="mb-2">
        <a asp-page="/Student/StudentDashboard" class="btn btn-storyboard btn-go text-decoration-none rounded-pill fw-bold btn-back-pill shadow-sm">
            <i class="bi bi-arrow-left fs-5"></i>
        </a>
    </div>

    <h1 class="fw-bold mb-4 font-monospace-title game-main-title">
        <i class="bi bi-controller"></i> Moosik Game :p
    </h1>

    <div class="row game-selection-container p-4 shadow-sm rounded-4 align-items-stretch">
        
        <!-- LEFT SIDE: Difficulty Filters (Fixed position, perfectly centered) -->
        <div class="col-12 col-md-4 game-left-col border-end-md py-3">
            <div class="d-flex flex-column justify-content-center align-items-center gap-3 w-100">

                <a asp-page="./GameSelection" asp-route-difficulty="All" 
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold @(Model.SelectedDifficulty == "All" ? "active-difficulty" : "")">
                    All
                </a>

                <a asp-page="./GameSelection" asp-route-difficulty="Easy" 
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold btn-difficulty-easy @(Model.SelectedDifficulty == "Easy" ? "active-difficulty-easy" : "")">
                    Easy
                </a>

                <a asp-page="./GameSelection" asp-route-difficulty="Medium" 
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold btn-difficulty-medium @(Model.SelectedDifficulty == "Medium" ? "active-difficulty-medium" : "")">
                    Medium
                </a>
                
                <a asp-page="./GameSelection" asp-route-difficulty="Hard" 
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold btn-difficulty-hard @(Model.SelectedDifficulty == "Hard" ? "active-difficulty-hard" : "")">
                    Hard
                </a>

            </div>
        </div>

        <!-- RIGHT SIDE: Scrollable Games Area -->
        <div class="col-12 col-md-8 game-right-col ps-md-4 py-3">
            <div class="d-flex flex-column gap-3">

                @if (Model.Games != null && Model.Games.Any())
                {
                    @foreach (var game in Model.Games)
                    {
                        <a asp-page="/Student/GameDetail" asp-route-id="@game.GameId" 
                            class="btn btn-storyboard btn-go text-decoration-none w-100 py-3 fw-bold">
                            @game.GameName
                        </a>
                    }
                }
                else
                {
                    <div class="text-muted text-center py-5">
                        No Game found.
                    </div>
                }

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Reset selection on browser refresh
        if (performance.getEntriesByType('navigation')[0]?.type === 'reload' || performance.navigation.type === 1) {
            if (window.location.search) {
                window.location.href = window.location.pathname;
            }
        }
    </script>
}