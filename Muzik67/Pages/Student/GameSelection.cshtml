@page
@model Muzik67.Pages.Student.GameSelectionModel
@{
    ViewData["Title"] = "Music Games";
}

<link rel="stylesheet" href="~/css/game-selection.css" asp-append-version="true" />

<div class="container py-4 py-lg-5">
    <header class="mc-status-bar d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
        <div>
            <p class="mb-1 text-white">MUSIC GAMES</p>
            <h1 class="h5 mb-0 text-white">Choose a sound challenge</h1>
        </div>
        <div>
            <p class="mc-lime-text mb-1">LIVES</p>
            <div class="mc-lives" aria-label="Two lives remaining out of three">
                <img src="~/images/full-heart.jpeg" class="mc-heart" alt="Full life" />
                <img src="~/images/full-heart.jpeg" class="mc-heart" alt="Full life" />
                <img src="~/images/empty-heart.jpeg" class="mc-heart" alt="Empty life" />
            </div>
        </div>
    </header>

    <nav class="mc-stage-tabs" aria-label="Learning stages">
        <a asp-page="/Student/MusicLessonSelection">1 Learn</a>
        <span>2 Practice</span>
        <span class="active">3 Challenge</span>
        <span aria-disabled="true">4 Reward</span>
    </nav>

    <p class="mb-4">GOAL: Pick a game, listen carefully, and answer every music question.</p>

    <section class="row game-selection-container p-3 p-lg-4 align-items-stretch" aria-label="Game browser">
        <aside class="col-12 col-md-4 game-left-col border-end-md py-3" aria-label="Difficulty filters">
            <h2 class="h6 mb-3">DIFFICULTY</h2>
            <div class="d-flex flex-column justify-content-center align-items-center gap-3 w-100">
                @foreach (var difficulty in new[] { "All", "Easy", "Medium", "Hard" })
                {
                    <a asp-page="./GameSelection" asp-route-difficulty="@difficulty"
                       class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 @(Model.SelectedDifficulty == difficulty ? "active-difficulty" : "")"
                       aria-current="@(Model.SelectedDifficulty == difficulty ? "page" : null)">
                        @difficulty
                    </a>
                }
            </div>
        </aside>

        <div class="col-12 col-md-8 game-right-col ps-md-4 py-3">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <h2 class="h6 mb-0">AVAILABLE CHALLENGES</h2>
                <span class="small">@Model.Games.Count found</span>
            </div>

            <div class="mc-game-list">
                @if (Model.Games.Any())
                {
                    @foreach (var game in Model.Games)
                    {
                        <article class="mc-game-row">
                            <div class="mc-game-block" aria-hidden="true"><i class="bi bi-music-note-beamed"></i></div>
                            <div class="flex-grow-1">
                                <h3 class="h6 mb-1">@game.GameName</h3>
                                <p class="mb-1">@game.Description</p>
                                <span class="small">@game.DifficultyLevel · @(game.Status == "Premium" ? "Diamond access" : "Free access")</span>
                            </div>
                            <a asp-page="/Student/GameDetail" asp-route-id="@game.GameId" class="btn btn-primary">Play &gt;</a>
                        </article>
                    }
                }
                else
                {
                    <div class="empty-state text-center">No games match this difficulty.</div>
                }
            </div>
        </div>
    </section>

    <div class="mt-3">
        <a asp-page="/Student/StudentDashboard" class="btn btn-outline-dark">&lt; Back to home map</a>
    </div>
</div>
