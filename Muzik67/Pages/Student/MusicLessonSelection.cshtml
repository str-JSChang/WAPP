@page
@model Muzik67.Pages.Student.MusicLessonSelectionModel
@{
    ViewData["Title"] = "Music Lesson Selection";
}

<link rel="stylesheet" href="~/css/music-lesson-selection.css" asp-append-version="true" />

<div class="container py-5">
    <h1 class="fw-bold mb-4 font-monospace-title lesson-main-title">
        <i class="bi bi-music-note-beamed"></i> Moosik Lesson :D
    </h1>

    <div class="row lesson-selection-container p-4 shadow-sm rounded-4 align-items-stretch">
        
        <!-- LEFT SIDE: Difficulty Filters (Fixed position, perfectly centered) -->
        <div class="col-12 col-md-4 lesson-left-col border-end-md py-3">
            <div class="d-flex flex-column justify-content-center align-items-center gap-3 w-100">
                <a asp-page="./MusicLessonSelection" asp-route-difficulty="Easy" 
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold @(Model.SelectedDifficulty == "Easy" ? "active-difficulty" : "")">
                    Easy
                </a>
                <a asp-page="./MusicLessonSelection" asp-route-difficulty="Normal" 
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold @(Model.SelectedDifficulty == "Normal" ? "active-difficulty" : "")">
                    Normal
                </a>
                <a asp-page="./MusicLessonSelection" asp-route-difficulty="Hard" 
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold @(Model.SelectedDifficulty == "Hard" ? "active-difficulty" : "")">
                    Hard
                </a>
            </div>
        </div>

        <!-- RIGHT SIDE: Scrollable Lessons Area -->
        <div class="col-12 col-md-8 lesson-right-col ps-md-4 py-3">
            @if (string.IsNullOrEmpty(Model.SelectedDifficulty))
            {
                <div class="text-muted text-center py-5 h-100 d-flex flex-column justify-content-center align-items-center">
                    <i class="bi bi-arrow-left-circle fs-2 d-block mb-2"></i>
                    <p class="mb-0">Please select a difficulty on the left to view lessons.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    
