@page
@model Muzik67.Pages.Student.MusicLessonSelectionModel
@{
    ViewData["Title"] = "Music Lesson Selection";
}

<link rel="stylesheet" href="~/css/music-lesson-selection.css" asp-append-version="true" />

<div class="container py-5">

    <header class="mc-status-bar d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
        <div>
            <p class="mb-1 text-white">LESSON MAP</p>
            <h1 class="h5 mb-0 text-white">Choose what to learn</h1>
        </div>
        <span class="mc-lime-text">@Model.SelectedType · @Model.SelectedDifficulty</span>
    </header>

    <nav class="mc-stage-tabs" aria-label="Learning stages">
        <span class="active">1 Learn</span>
        <span>2 Practice</span>
        <a asp-page="/Student/GameSelection">3 Challenge</a>
        <span aria-disabled="true">4 Reward</span>
    </nav>

    <div class="row lesson-selection-container p-4 shadow-sm rounded-4 align-items-stretch">
        
        <!-- LEFT SIDE: Content Type Filters -->
        <div class="col-12 col-md-4 lesson-left-col border-end-md py-3">
            <div class="d-flex flex-column justify-content-center align-items-center gap-3 w-100">
                <a asp-page="./MusicLessonSelection" asp-route-type="All" asp-route-difficulty="@Model.SelectedDifficulty"
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold @(Model.SelectedType == "All" ? "active-difficulty" : "")">
                    All Types
                </a>
                
                <a asp-page="./MusicLessonSelection" asp-route-type="Theory" asp-route-difficulty="@Model.SelectedDifficulty"
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold btn-type-theory @(Model.SelectedType == "Theory" ? "active-theory" : "")">
                    Theory
                </a>

                <a asp-page="./MusicLessonSelection" asp-route-type="EarTraining" asp-route-difficulty="@Model.SelectedDifficulty"
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold btn-type-eartraining @(Model.SelectedType == "EarTraining" ? "active-eartraining" : "")">
                    Ear Training
                </a>
                
                <a asp-page="./MusicLessonSelection" asp-route-type="Instrument" asp-route-difficulty="@Model.SelectedDifficulty"
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold btn-type-instrument @(Model.SelectedType == "Instrument" ? "active-instrument" : "")">
                    Instrument
                </a>

            </div>
        </div>

        <!-- RIGHT SIDE: Difficulty Bar + Scrollable Lessons Area -->
        <div class="col-12 col-md-8 lesson-right-col ps-md-4 py-3">

            <!-- Difficulty Bar -->
            <div class="d-flex justify-content-around align-items-center pd-3 border-bottom mb-3 gap-2">
                <a asp-page="./MusicLessonSelection" asp-route-type="@Model.SelectedType" asp-route-difficulty="All"
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold @(Model.SelectedDifficulty == "All" ? "active-difficulty" : "")">
                    All
                </a>
                
                <a asp-page="./MusicLessonSelection" asp-route-type="@Model.SelectedType" asp-route-difficulty="Easy"
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold btn-difficulty-easy @(Model.SelectedDifficulty == "Easy" ? "active-easy" : "")">
                    Easy
                </a>

                <a asp-page="./MusicLessonSelection" asp-route-type="@Model.SelectedType" asp-route-difficulty="Medium"
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold btn-difficulty-medium @(Model.SelectedDifficulty == "Medium" ? "active-medium" : "")">
                    Medium
                </a>

                <a asp-page="./MusicLessonSelection" asp-route-type="@Model.SelectedType" asp-route-difficulty="Hard"
                   class="btn btn-storyboard btn-go text-decoration-none w-75 py-3 fw-bold btn-difficulty-hard @(Model.SelectedDifficulty == "Hard" ? "active-hard" : "")">
                    Hard
                </a>

            </div>

            <!-- Lesson List (Scrollable) -->
            <div class="lesson-scroll-wrapper">
                <div class="d-flex flex-column gap-3">

                    @if (Model.Lessons != null && Model.Lessons.Any())
                    {
                        @foreach (var lesson in Model.Lessons)
                        {
                            <a asp-page="/Student/LessonContent" asp-route-id="@lesson.ContentId" 
                            class="btn btn-storyboard btn-go text-decoration-none w-100 py-3 fw-bold text-decoration-none text-truncate shadow-sm">
                                @lesson.Title
                                @if (Model.CompletedLessonIds.Contains(lesson.ContentId))
                                {
                                    <span class="badge bg-success ms-2">Completed</span>
                                }
                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-muted text-center py-5">
                            No lessons found.
                        </div>
                    }

                </div>

            </div>
            
        </div>

    </div>

    <div class="mt-3">
        <a asp-page="/Student/StudentDashboard" class="btn btn-outline-dark">&lt; Back to home map</a>
    </div>
</div>
