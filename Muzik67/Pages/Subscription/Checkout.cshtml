@page
@model Muzik67.Pages.Subscription.CheckoutModel
@{
    ViewData["Title"] = "Confirm Subscription";
}

<link rel="stylesheet" href="~/css/management.css" asp-append-version="true" />

<main class="container subscription-page py-5">
    <div class="checkout-card mx-auto">
        <a asp-page="/Subscription/Plans" class="text-decoration-none text-muted">← Back to plans</a>
        <h1 class="management-title mt-3">Confirm your plan</h1>
        <p class="text-muted">Review your subscription before activating it.</p>

        @if (Model.Plan is not null)
        {
            <div class="checkout-summary my-4">
                <div class="d-flex justify-content-between gap-3">
                    <strong>@Model.Plan.PlanName</strong>
                    <strong>@Model.Plan.Price.ToString("C")</strong>
                </div>
                <p class="text-muted mb-0 mt-2">@Model.Plan.Description</p>
                <hr />
                <div class="d-flex justify-content-between">
                    <span>Billing period</span><span>@Model.Plan.Duration</span>
                </div>
                <div class="d-flex justify-content-between mt-2">
                    <span>Access duration</span>
                    <span>@(Model.Plan.Duration == "Monthly" ? "1 month" : "1 year")</span>
                </div>
            </div>

            <div class="alert alert-warning small">
                Demonstration checkout only. No payment is processed and you should not enter payment-card details.
            </div>
            <form method="post" asp-page-handler="Confirm">
                <input type="hidden" name="planId" value="@Model.Plan.PlanId" />
                <button type="submit" class="btn btn-primary rounded-pill w-100">Confirm subscription</button>
            </form>
        }
    </div>
</main>
