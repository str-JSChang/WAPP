@page
@model Muzik67.Pages.Subscription.PlansModel
@{
    ViewData["Title"] = "Subscription Plans";
}

<link rel="stylesheet" href="~/css/management.css" asp-append-version="true" />

<main class="container subscription-page py-5">
    <div class="text-center mb-4">
        <p class="text-uppercase text-muted small fw-semibold mb-1">Keep learning and playing</p>
        <h1 class="management-title">Subscription Plans</h1>
        <p class="text-muted">Choose a plan to unlock premium music lessons and games.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-info" role="status">@Model.StatusMessage</div>
    }

    @if (Model.CurrentSubscription is not null)
    {
        <section class="current-subscription mb-4" aria-label="Current subscription">
            <div>
                <span class="badge text-bg-success mb-2">Active subscription</span>
                <h2 class="h4 mb-1">@Model.CurrentSubscription.Plan?.PlanName</h2>
                <p class="text-muted mb-0">
                    Expires @Model.CurrentSubscription.EndDate.ToLocalTime().ToString("d")
                    · @Model.CurrentSubscription.Plan?.Price.ToString("C") / @Model.CurrentSubscription.Plan?.Duration.ToLowerInvariant()
                </p>
            </div>
            <a asp-page="/Student/Subscription" class="btn btn-outline-dark rounded-pill">View subscription</a>
        </section>
    }

    <p class="demo-payment-note text-center mb-4">
        Demo checkout only: no real payment is processed and no card details are collected.
    </p>

    <div class="row g-4 justify-content-center">
        @foreach (var plan in Model.Plans)
        {
            var isCurrent = Model.CurrentSubscription?.PlanId == plan.PlanId;
            <div class="col-12 col-md-6 col-lg-5">
                <article class="plan-card h-100">
                    @if (isCurrent)
                    {
                        <span class="badge text-bg-success">Your current plan</span>
                    }
                    <h2 class="h3 mt-2">@plan.PlanName</h2>
                    <p class="plan-price">@plan.Price.ToString("C") <span>/ @plan.Duration.ToLowerInvariant()</span></p>
                    <p class="text-muted flex-grow-1">@plan.Description</p>
                    @if (isCurrent)
                    {
                        <button class="btn btn-secondary rounded-pill w-100" type="button" disabled>Currently subscribed</button>
                    }
                    else
                    {
                        <a asp-page="/Subscription/Checkout" asp-route-planId="@plan.PlanId" class="btn btn-primary rounded-pill w-100">
                            @(Model.CurrentSubscription is null ? "Choose plan" : "Switch to this plan")
                        </a>
                    }
                </article>
            </div>
        }
        @if (Model.Plans.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-secondary text-center">No subscription plans are available right now.</div>
            </div>
        }
    </div>
</main>
