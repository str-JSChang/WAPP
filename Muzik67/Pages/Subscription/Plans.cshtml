@page
@model Muzik67.Pages.Subscription.PlansModel
@{
    ViewData["Title"] = "Choose Your Plan";
    Layout = "_StudentLayout";
}

<link rel="stylesheet" href="~/css/management.css" asp-append-version="true" />

<main class="container subscription-page mc-pricing-page py-4 py-lg-5">
    <header class="mc-status-bar d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-end">
        <div>
            <p class="mb-1 text-white">CHOOSE YOUR PLAN</p>
            <h1 class="h4 mb-0 text-white">For parents only</h1>
        </div>
        <strong class="text-uppercase mc-lime-text">MUZIK 67</strong>
    </header>

    <p class="demo-payment-note text-center mb-4">
        7-day free trial on paid plans. Demo checkout only—no card details are collected.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-info" role="status">@Model.StatusMessage</div>
    }

    @if (Model.CurrentSubscription is not null)
    {
        <section class="current-subscription mb-4" aria-label="Current subscription">
            <div>
                <span class="badge mb-2">YOUR PLAN</span>
                <h2 class="h5 mb-1">@Model.CurrentSubscription.Plan?.PlanName</h2>
                <p class="mb-0">
                    Active until @Model.CurrentSubscription.EndDate.ToLocalTime().ToString("dd MMM yyyy")
                </p>
            </div>
            <a asp-page="/Student/Subscription" class="btn btn-outline-dark">View subscription</a>
        </section>
    }

    <section class="mc-plan-grid" aria-label="Available plans">
        @foreach (var plan in Model.Plans)
        {
            var isCurrent = Model.CurrentSubscription?.PlanId == plan.PlanId;
            var isFree = plan.Price == 0;
            var isYearly = string.Equals(plan.Duration, "Yearly", StringComparison.OrdinalIgnoreCase);
            var tierClass = isFree ? "wood" : (isYearly ? "diamond" : "iron");
            var tierName = isFree ? "WOOD" : (isYearly ? "DIAMOND" : "IRON");

            <article class="plan-card @tierClass @(isYearly ? "best-value" : "")">
                @if (isYearly)
                {
                    <span class="mc-plan-ribbon">BEST VALUE</span>
                }
                else if (isCurrent)
                {
                    <span class="mc-plan-ribbon current-plan-ribbon">YOUR PLAN</span>
                }

                <p class="mb-0">@tierName</p>
                <div class="mc-plan-block" aria-hidden="true"></div>
                <h2 class="h5">@plan.PlanName</h2>
                <p class="plan-price mb-1">
                    @(isFree ? "FREE" : $"RM {plan.Price:0.##}")
                </p>
                <p class="small mb-2">@(isFree ? "forever" : $"per {plan.Duration.ToLowerInvariant().Replace("ly", "")}")</p>

                <ul class="mc-feature-list flex-grow-1">
                    <li>Music lesson previews</li>
                    <li>@(isFree ? "One starter lesson" : "All lessons and quizzes")</li>
                    <li class="@(isFree ? "locked" : "")">Music games and virtual keyboard</li>
                    <li class="@(isFree ? "locked" : "")">Progress tracking</li>
                    @if (isYearly)
                    {
                        <li>Printable certificates</li>
                    }
                </ul>

                @if (isCurrent)
                {
                    <button class="btn btn-secondary w-100" type="button" disabled>Current plan</button>
                }
                else
                {
                    <a asp-page="/Subscription/Checkout" asp-route-planId="@plan.PlanId" class="btn @(isYearly ? "btn-primary" : "btn-outline-dark") w-100">
                        Choose @tierName
                    </a>
                }
            </article>
        }

        @if (Model.Plans.Count == 0)
        {
            <div class="alert alert-secondary text-center">No subscription plans are available right now.</div>
        }
    </section>

    <div class="mc-parent-strip">
        <section class="mc-parent-panel" aria-labelledby="parent-gate-heading">
            <h2 id="parent-gate-heading" class="h6">PARENT GATE</h2>
            <p class="mb-0">Ask a grown-up before choosing or changing a paid plan.</p>
        </section>
        <section class="mc-parent-panel" aria-labelledby="safe-heading">
            <h2 id="safe-heading" class="h6">SAFE &amp; SIMPLE</h2>
            <p class="mb-0">No ads. Parents stay in control.</p>
        </section>
    </div>

    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mt-3">
        <a asp-page="/Student/StudentDashboard" class="btn btn-outline-dark">&lt; Back</a>
        <a asp-page="/Student/Subscription" class="btn btn-outline-dark">Restore / view plan</a>
    </div>
</main>
