<!DOCTYPE html>
@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Muzik 67</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Muzik67.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/minecraft-ui.css" asp-append-version="true" />
</head>
<body class="minecraft-shell student-shell d-flex flex-column min-vh-100">
    <a class="skip-link" href="#mainContent">Skip to content</a>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light custom-navbar sticky-top">
            <div class="container">
                <!-- Top-Left Logo matching Storyboard Slide 3 -->
                <a class="navbar-brand brand-wrapper" asp-area="" asp-page="/Index">
                    <img src="~/images/muzik67-logo.svg" alt="Muzik 67 Logo" class="nav-brand-logo" />
                    <span class="nav-brand-text">Muzik 67</span>
                </a>

                <button class="navbar-toggler" type="button"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation"
                        onclick="const menu = document.getElementById('mainNavbar'); const open = menu.classList.toggle('show'); this.setAttribute('aria-expanded', open.toString());">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 mc-nav-tabs">
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.Contains("StudentDashboard") ? "active" : "")" asp-area="" asp-page="/Student/StudentDashboard">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.Contains("MusicLesson") || currentPath.Contains("LessonContent") ? "active" : "")" asp-page="/Student/MusicLessonSelection">Lessons</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.Contains("Game") ? "active" : "")" asp-page="/Student/GameSelection">Games</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.Contains("Instrument") ? "active" : "")" asp-page="/Student/Instrument">Instrument</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.Contains("Progress") ? "active" : "")" asp-page="/Student/Progress">Progress</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.Contains("Subscription") ? "active" : "")" asp-page="/Subscription/Plans">Plans</a>
                        </li>
                    </ul>

                    <!-- Top-Right Actions -->
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        <div class="d-flex align-items-center gap-2 ms-auto">
                            <button type="button" id="readPageAloud" class="btn btn-outline-dark btn-sm" title="Read this page aloud"><i class="bi bi-volume-up"></i> Read</button>
                            <a asp-page="/Account/Profile" class="btn btn-outline-dark rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 40px; height: 40px;" title="My Profile">
                                <i class="bi bi-person-circle fs-4"></i>
                            </a>
                            <form method="post" asp-page="/Account/Login" asp-page-handler="Logout" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Sign Out</button>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </nav>
    </header>

    <main id="mainContent" role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer matching Storyboard Slide 3 -->
    <footer class="custom-footer mt-auto">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <img src="~/images/muzik67-logo.svg" alt="Muzik 67 Logo" class="footer-logo" />
                    <span class="fw-bold fs-6 text-dark">Muzik 67</span>
                    <span class="text-muted small ms-2">&copy; 2026 Asia Pacific University (CT050-3-2)</span>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap justify-content-center">
                    <a asp-page="/Privacy" class="footer-nav-link">Term and Condition</a>
                    <span class="text-muted">•</span>
                    <a href="/#aboutSection" class="footer-nav-link">About Us</a>
                    <span class="text-muted">•</span>
                    <a asp-page="/Privacy" class="footer-nav-link">Privacy Policy</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('readPageAloud')?.addEventListener('click', () => {
            if (!('speechSynthesis' in window)) return;
            speechSynthesis.cancel();
            const main = document.getElementById('mainContent');
            const readable = Array.from(main?.querySelectorAll('h1,h2,h3,p,label,button,a') || [])
                .filter(element => !element.closest('script,[aria-hidden="true"]'))
                .map(element => element.textContent?.trim()).filter(Boolean).join('. ');
            speechSynthesis.speak(new SpeechSynthesisUtterance(readable.slice(0, 5000)));
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
