@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="container py-5">
    <header class="mc-status-bar">
        <p class="mb-1 text-white">SYSTEM MESSAGE</p>
        <h1 class="h4 mb-0 text-white">This path hit a broken block</h1>
    </header>

    <section class="mc-result-panel text-center mx-auto mc-error-panel">
        <div class="mc-badge-block mx-auto mb-3" aria-hidden="true">!</div>
        <h2 class="h5">We could not finish that request.</h2>
        <p>Return to the home map and try the action again.</p>

        @if (Model.ShowRequestId)
        {
            <p class="small"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }

        <a asp-page="/Index" class="btn btn-primary">Return home &gt;</a>
    </section>
</div>
