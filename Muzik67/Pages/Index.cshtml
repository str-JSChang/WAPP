@page
@model IndexModel
@{
    ViewData["Title"] = "Muzik 67 - Interactive Music Learning Adventure";
}

<!-- =========================================================================
     STORYBOARD INTRO ANIMATION OVERLAY (Slides 1 & 2)
     Slide 1: Full black screen with Logo in the center.
     Slide 2: Logo fades out.
     Slide 3: Animation shifts smoothly into the landing page.
     ========================================================================= -->
<div id="introOverlay">
    <!-- Floating background musical particles -->
    <span class="music-note-float" style="top: 20%; left: 15%;">♪</span>
    <span class="music-note-float" style="top: 28%; right: 20%; animation-delay: 1s;">♫</span>
    <span class="music-note-float" style="bottom: 25%; left: 22%; animation-delay: 2s;">♬</span>
    <span class="music-note-float" style="bottom: 30%; right: 18%; animation-delay: 1.5s;">♩</span>

    <div class="intro-content">
        <div class="intro-logo-wrapper">
            <!-- Center Logo as requested in Slide 1 -->
            <img src="~/images/muzik67-logo.svg" alt="Muzik 67 Logo" class="intro-logo-svg" />
            <h1 class="intro-title">Muzik 67</h1>
            <p class="intro-tagline">Music Learning Adventure</p>
        </div>
    </div>

    <!-- Intro Interactive Controls -->
    <div class="intro-controls">
        <button id="soundToggleBtn" type="button" class="intro-btn" title="Toggle audio chime">
            🔊 Sound: On
        </button>
        <button id="skipIntroBtn" type="button" class="intro-btn" title="Skip directly to landing page">
            Skip Intro [Esc]
        </button>
    </div>
</div>

<!-- =========================================================================
     MINECRAFT VIDEO BACKGROUND LAYER
     4-Phase Scene: Surface Loop -> Diving Transition -> Underwater Loop -> Resurface
     ========================================================================= -->
<div class="landing-video-fixed-bg" aria-hidden="true">
    <video id="landingBgVideo" autoplay muted loop playsinline preload="auto">
        <source src="~/videos/minecraft-bg.mp4" type="video/mp4" />
    </video>
    <div class="video-tint-overlay"></div>
</div>

<!-- Floating Ambient Music Control (Allows unmuting the video's audio track) -->
<audio id="audioDive" src="/audio/dive.m4a" preload="auto"></audio>
<audio id="audioResurface" src="/audio/resurface.m4a" preload="auto"></audio>
<audio id="audioSurfaceWater" src="/audio/surfacewater.m4a" preload="auto" loop></audio>
<audio id="audioUnderwater" src="/audio/underwater.m4a" preload="auto" loop></audio>

<button id="bgmToggleBtn" type="button" class="bgm-float-btn shadow-lg" title="Toggle World Ambience Audio">
    <i class="bi bi-volume-mute-fill" id="bgmIcon"></i>
    <span id="bgmLabel">Play Ambience</span>
</button>

<!-- =========================================================================
     LANDING PAGE CONTENT & 4-PHASE SECTIONS
     ========================================================================= -->
<div id="landingWrapper" class="landing-page-wrapper">

    <!-- PHASE 1: ABOVE WATER SURFACE (Hero Section) -->
    <section class="landing-hero-fullscreen d-flex flex-column justify-content-center align-items-center text-center">
        <div class="container position-relative z-2 hero-inner">
            <!-- Minecraft World Badge -->
            <div class="mc-tag-badge mb-3">
                <i class="bi bi-compass-fill me-1"></i> OVERWORLD · MUSICAL ADVENTURE
            </div>

            <!-- Main Title Box -->
            <div class="landing-hero-card">
                <h1 class="landing-title">Muzik 67</h1>
            </div>

            <p class="landing-subtitle">
                An engaging online learning platform that introduces children aged 6–7 to the
                fundamentals of music in a fun, simple, and age-appropriate way.
            </p>

            <!-- Action Buttons: Get Started + Explore the Underwater -->
            <div class="landing-actions mt-4">
                <a asp-page="/Account/Register" class="btn btn-storyboard btn-get-started text-decoration-none">
                    <i class="bi bi-stars me-1"></i> Get Started
                </a>
                <button type="button" id="exploreUnderwaterBtn" class="btn btn-storyboard btn-explore-underwater text-decoration-none">
                    <i class="bi bi-water me-1"></i> Explore the Underwater
                </button>
            </div>
        </div>
    </section>

    <!-- =========================================================================
         PHASE 2 & 3: UNDERWATER REALMS (Navigation Hubs)
         ========================================================================= -->
    <section id="realmNavigation" class="container py-5 my-3 position-relative z-2">
        <div class="text-center mb-5 scroll-reveal">
            <span class="mc-sub-badge"><i class="bi bi-water me-1"></i> UNDERWATER REALMS</span>
            <h2 class="display-5 fw-bold text-white text-shadow-mc mt-2">Choose Your Realm</h2>
            <p class="text-light opacity-75 max-w-600 mx-auto">
                Step into interactive lessons, challenging ear-training games, or track your musical journey beneath the waves.
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            <!-- Realm 1: Music Lessons -->
            <div class="col-12 col-md-6 col-lg-4 scroll-reveal">
                <div class="realm-card h-100 d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="realm-icon-box bg-emerald">
                            <i class="bi bi-music-note-beamed"></i>
                        </div>
                        <h3 class="realm-title text-white mt-3">Theory Lessons</h3>
                        <p class="realm-desc text-light opacity-75">
                            Learn the treble clef, note names, pitch, and rhythmic beats through clear, illustrated music stories.
                        </p>
                    </div>
                    <div class="mt-4 pt-2 border-top border-white-10">
                        <a asp-page="/Student/MusicLessonSelection" class="btn btn-realm btn-realm-green w-100 fw-bold">
                            Enter Lessons <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Realm 2: Interactive Games -->
            <div class="col-12 col-md-6 col-lg-4 scroll-reveal" style="animation-delay: 0.15s;">
                <div class="realm-card h-100 d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="realm-icon-box bg-gold">
                            <i class="bi bi-controller"></i>
                        </div>
                        <h3 class="realm-title text-white mt-3">Musical Games</h3>
                        <p class="realm-desc text-light opacity-75">
                            Play Note Matcher and Guess the Sound! Listen carefully to musical pitches and test your ear.
                        </p>
                    </div>
                    <div class="mt-4 pt-2 border-top border-white-10">
                        <a asp-page="/Student/GameSelection" class="btn btn-realm btn-realm-gold w-100 fw-bold">
                            Play Games <i class="bi bi-controller ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Realm 3: Progress & Score Tracking -->
            <div class="col-12 col-md-6 col-lg-4 scroll-reveal" style="animation-delay: 0.3s;">
                <div class="realm-card h-100 d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="realm-icon-box bg-blue">
                            <i class="bi bi-trophy-fill"></i>
                        </div>
                        <h3 class="realm-title text-white mt-3">My Progress</h3>
                        <p class="realm-desc text-light opacity-75">
                            View your highest scores, practice attempt logs, and watch your mastery progress meters rise.
                        </p>
                    </div>
                    <div class="mt-4 pt-2 border-top border-white-10">
                        <a asp-page="/Student/Progress" class="btn btn-realm btn-realm-blue w-100 fw-bold">
                            View Progress <i class="bi bi-bar-chart-fill ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================================
         SECTION 3: INTERACTIVE NOTE BLOCK PIANO (Sound Synthesizer)
         ========================================================================= -->
    <section class="container py-5 my-2 position-relative z-2">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">
                <div class="noteblock-piano-panel p-4 p-md-5 text-center text-white scroll-reveal">
                    <span class="mc-tag-badge mb-2">
                        <i class="bi bi-soundwave"></i> LIVE INSTRUMENT
                    </span>
                    <h2 class="display-6 fw-bold text-shadow-mc mb-1">Interactive Note Block Piano</h2>
                    <p class="text-light opacity-75 mb-4">Click or press any note key to synthesize real acoustic pitches!</p>

                    <!-- 7-Key Keyboard with Web Audio API synthesis -->
                    <div class="piano-keyboard-grid py-2">
                        <button type="button" class="mc-piano-key" data-note="261.63" onclick="playTone(261.63, this)">
                            <span class="key-letter">C</span>
                            <span class="key-solfege">Do</span>
                        </button>
                        <button type="button" class="mc-piano-key" data-note="293.66" onclick="playTone(293.66, this)">
                            <span class="key-letter">D</span>
                            <span class="key-solfege">Re</span>
                        </button>
                        <button type="button" class="mc-piano-key" data-note="329.63" onclick="playTone(329.63, this)">
                            <span class="key-letter">E</span>
                            <span class="key-solfege">Mi</span>
                        </button>
                        <button type="button" class="mc-piano-key" data-note="349.23" onclick="playTone(349.23, this)">
                            <span class="key-letter">F</span>
                            <span class="key-solfege">Fa</span>
                        </button>
                        <button type="button" class="mc-piano-key" data-note="392.00" onclick="playTone(392.00, this)">
                            <span class="key-letter">G</span>
                            <span class="key-solfege">Sol</span>
                        </button>
                        <button type="button" class="mc-piano-key" data-note="440.00" onclick="playTone(440.00, this)">
                            <span class="key-letter">A</span>
                            <span class="key-solfege">La</span>
                        </button>
                        <button type="button" class="mc-piano-key" data-note="493.88" onclick="playTone(493.88, this)">
                            <span class="key-letter">B</span>
                            <span class="key-solfege">Ti</span>
                        </button>
                    </div>

                    <p class="small text-light opacity-50 mt-3 mb-0">
                        Synthesized live using the Web Audio API • 440Hz Concert Pitch
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================================
         SECTION 4: FEATURES & RESURFACE TO OVERWORLD
         ========================================================================= -->
    <section id="aboutSection" class="container py-5 my-2 position-relative z-2">
        <div class="row g-4 mb-5">
            <div class="col-md-4 scroll-reveal">
                <div class="feature-card-mc h-100 p-4">
                    <div class="feature-icon-bubble">🎹</div>
                    <h5 class="fw-bold text-white mt-3">Virtual Instruments</h5>
                    <p class="text-light opacity-75 small mb-0">
                        Explore musical keyboards and percussion instruments right in the browser with interactive sound.
                    </p>
                </div>
            </div>
            <div class="col-md-4 scroll-reveal" style="animation-delay: 0.15s;">
                <div class="feature-card-mc h-100 p-4">
                    <div class="feature-icon-bubble">👂</div>
                    <h5 class="fw-bold text-white mt-3">Ear-Training Games</h5>
                    <p class="text-light opacity-75 small mb-0">
                        Fun games like "Guess the Sound" and melody matching specifically designed for children aged 6 to 7.
                    </p>
                </div>
            </div>
            <div class="col-md-4 scroll-reveal" style="animation-delay: 0.3s;">
                <div class="feature-card-mc h-100 p-4">
                    <div class="feature-icon-bubble">🏆</div>
                    <h5 class="fw-bold text-white mt-3">Visual Progress Tracking</h5>
                    <p class="text-light opacity-75 small mb-0">
                        Celebrate every milestone with visual progress meters, high scores, and rewarding completion badges.
                    </p>
                </div>
            </div>
        </div>

        <!-- PHASE 4: RESURFACE TO SURFACE BUTTON -->
        <div class="text-center pt-3 pb-4">
            <button type="button" id="resurfaceBtn" class="btn btn-storyboard btn-resurface shadow-lg">
                <i class="bi bi-arrow-up-circle-fill me-2"></i> Resurface to Overworld
            </button>
        </div>
    </section>

</div>

